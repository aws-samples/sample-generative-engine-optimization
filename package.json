{
  "name": "generative-engine-optimization-aws",
  "version": "0.1.0",
  "description": "AWS CDK infrastructure for a blog platform (CloudFront, Aurora, Lambda, Bedrock agent, S3, Athena, CloudWatch monitoring).",
  "private": true,
  "bin": {
    "app": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc -w",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integ": "jest --selectProjects integration",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "aws-cdk": "2.1141.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "cdk-nag": "^2.35.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "braces": "3.0.3",
    "handlebars": "4.7.10",
    "sprintf-js": "1.1.3"
  }
}
