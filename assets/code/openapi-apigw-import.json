{
  "openapi": "3.0.3",
  "info": {
    "title": "Octank Hotels API (augmented, API Gateway import)",
    "version": "0.1.0",
    "description": "AUGMENTED spec with x-amazon-apigateway-* extensions, imported into API Gateway. The clean served spec is at web_application/openapi.json."
  },
  "paths": {
    "/properties": {
      "get": {
        "summary": "List hotel properties",
        "responses": { "200": { "description": "A list of properties" } },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "REPLACED_AT_DEPLOY_WITH_API_HANDLER_LAMBDA_ARN",
          "payloadFormatVersion": "1.0"
        }
      }
    },
    "/availability": {
      "get": {
        "summary": "Check room availability and rates",
        "responses": { "200": { "description": "Availability results" } },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "REPLACED_AT_DEPLOY_WITH_API_HANDLER_LAMBDA_ARN",
          "payloadFormatVersion": "1.0"
        }
      }
    }
  }
}
